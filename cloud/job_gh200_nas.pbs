#PBS -S /bin/bash
#PBS -N sam2roman_gh200
#PBS -l select=1:ncpus=72:mpiprocs=1:model=gh200
#PBS -l walltime=04:00:00
#PBS -q gpu_normal
#PBS -j oe
#PBS -W group_list=s3371
#PBS -o /nobackup/pmsanch1/unet_training.log
# ==============================================================================
# NASA HECC Grace Hopper (GH200) Batch Training Job
# Reference: https://www.nas.nasa.gov/hecc/support/kb/machine-learning-overview_572.html
# ==============================================================================

module purge
module use -a /swbuild/analytix/tools/modulefiles
module load miniconda3/gh2
source activate pyt2_5_gh

# Optimize CPU threading and output flushing
export OMP_NUM_THREADS=2
export PYTHONUNBUFFERED=1


echo "================================================================="
echo " Job started on: $(hostname) at $(date)"
echo " CUDA Device: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader)"
echo " Working directory: $(pwd)"
echo "================================================================="
# -----------------------------------------------------------------------------
# Launch StarNet3 Training
# -----------------------------------------------------------------------------


# 3. Launch GH200 High-Throughput Training
python /nobackup/pmsanch1/code/sam2roman/cloud/train_gh200.py \
    --train_shards /nobackup/pmsanch1/data/webdataset_all/train/*tar \
    --val_shards /nobackup/pmsanch1/data/webdataset_all/val/*.tar \
    --output_dir /nobackup/pmsanch1/experiments/unet_gh200_80epochs \
    --batch_size 32 \
    --epochs 80 \
    --lr 6e-5 \
    --soft_boundary \
    --boundary_sigma 1.2 \
    --num_workers 8 \
    --scheduler cosine --warmup_epochs 3 \
    --boundary_tolerance 1 \

echo "================================================================="
echo " Job finished at $(date) with exit code $?"
echo "================================================================="
