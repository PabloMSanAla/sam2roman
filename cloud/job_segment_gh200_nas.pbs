#PBS -S /bin/bash
#PBS -N sam2roman_segment_gh200
#PBS -l select=1:ncpus=72:mpiprocs=1:model=gh200
#PBS -l walltime=04:00:00
#PBS -q gpu_normal
#PBS -j oe
#PBS -W group_list=s3371
#PBS -o /nobackup/pmsanch1/segment_training.log
# ==============================================================================
# NASA HECC Grace Hopper (GH200) Batch Training Job: Center Offset Voting
# Reference: https://www.nas.nasa.gov/hecc/support/kb/machine-learning-overview_572.html
# ==============================================================================

# 1. Initialize NAS environment modules in subshell
module purge 
module use -a /swbuild/analytix/tools/modulefiles 
module load miniconda3/gh2
source activate pyt2_6_gh 

PYTHON_BIN="$(which python)"

# Optimize CPU threading and memory allocation on GH200 (ARM 72 cores)
export OMP_NUM_THREADS=2
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export CUDA_DEVICE_ORDER=PCI_BUS_ID

echo "================================================================="
echo " Job started on: $(hostname) at $(date)"
echo " CUDA Device: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo 'N/A')"
echo " Python Binary: $($PYTHON_BIN -c 'import sys; print(sys.executable)')"
echo " Python Version: $($PYTHON_BIN --version 2>&1)"
echo " Working directory: $(pwd)"
echo "================================================================="

# 2. Stage dataset shards to local fast NVMe SSD ($TMPDIR) or RAM (/dev/shm)
# For a 103 GB dataset on GH200 (480 GB unified RAM + NVMe SSD), staging eliminates
# Lustre/NFS network I/O latency and keeps GPU streaming at ~100% efficiency.
DATA_DIR="/nobackup/pmsanch1/data/webdataset_instance"
if [ -d "$TMPDIR" ]; then
    echo "[I/O] Staging shards to node-local NVMe SSD: $TMPDIR/shards..."
    mkdir -p "$TMPDIR/shards"
    cp -r "$DATA_DIR"/* "$TMPDIR/shards/"
    TRAIN_SHARDS="$TMPDIR/shards/train/*.tar"
    VAL_SHARDS="$TMPDIR/shards/val/*.tar"
elif [ -d "/dev/shm" ]; then
    echo "[I/O] Staging shards to node RAM disk: /dev/shm/shards..."
    mkdir -p "/dev/shm/shards"
    cp -r "$DATA_DIR"/* "/dev/shm/shards/"
    TRAIN_SHARDS="/dev/shm/shards/train/*.tar"
    VAL_SHARDS="/dev/shm/shards/val/*.tar"
else
    TRAIN_SHARDS="/nobackup/pmsanch1/data/webdataset_instance/train/*.tar"
    VAL_SHARDS="/nobackup/pmsanch1/data/webdataset_instance/val/*.tar"
fi

# 3. Launch GH200 SteerQuery Star-Deblending Training
# batch_size=16 (fits safely within ~28 GB VRAM); grad_accum_steps=2 yields effective batch size 32.
$PYTHON_BIN /nobackup/pmsanch1/code/sam2roman/cloud/train_segment_gh200.py \
    --train_shards "$TRAIN_SHARDS" \
    --val_shards "$VAL_SHARDS" \
    --output_dir /nobackup/pmsanch1/experiments/steer_query_gh200_80epochs \
    --batch_size 16 \
    --grad_accum_steps 2 \
    --epochs 80 \
    --lr 6e-5 \
    --num_workers 27 \
    --prefetch_factor 4 \
    --sem_weight 1.0 \
    --center_weight 2.0 \
    --gate_weight 1.0 \
    --inst_weight 1.0 \
    --warmup_epochs 5 \
    --scheduler cosine \
    --plot_interval 5
    --scheduler cosine --warmup_epochs 3 \
    --plot_interval 5

echo "================================================================="
echo " Job finished at $(date) with exit code $?"
echo "================================================================="
